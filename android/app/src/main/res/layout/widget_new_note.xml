<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 的「新建小记」小组件。
     上半是卡片（应用图标 + 一行描述），下半是标题「新建小记」——
     很多桌面不会绘制组件名，所以标题由我们自己画在卡片下方，
     视觉上就等同于图标下面那行 App 名称。

     高度策略（对齐桌面图标）：
     不写死卡片高度，也不写死顶部偏移。卡片用 weight 吃掉可用高度，
     上下各留一段同比例的「呼吸位」（weight≈0.12）：不同启动器给 1 行
     的高度约 40–100dp，呼吸位会随宿主高度自动伸缩，顶部始终比图标
     的自然内缩多一点，不会出现「比旁边图标高/矮一截」。
     宿主太矮时由 Provider 读取 OPTION_APPWIDGET_MIN_HEIGHT 隐藏标题，
     卡片自动占满剩余空间。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 顶部呼吸位：与卡片高度成固定比例，随宿主行高自适应。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12" />

        <LinearLayout
            android:id="@+id/widget_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_new_note_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_circle"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_widget_pen"
                android:tint="@color/widget_icon_fg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="@string/widget_new_note_desc_text"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:text="@string/shortcut_new_note_long"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />

        <!-- 底部呼吸位：与顶部同权重，保证卡片在单元格内垂直居中。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12" />

    </LinearLayout>

</FrameLayout>
