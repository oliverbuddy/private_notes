<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 的「新建小记」小组件。
     上半是卡片（应用图标 + 一行描述），下半是标题「新建小记」——
     很多桌面不会绘制组件名，所以标题由我们自己画在卡片下方，
     视觉上就等同于图标下面那行 App 名称。

     高度策略（对齐桌面图标）：
     卡片用 weight 吃满「宿主行高 - 标题高度」，底部贴住单元格底边，
     整体高度与桌面图标一致；只在顶部留一个固定的视觉内缩
     （@dimen/widget_top_inset），让卡片顶边和图标顶边对齐。
     底部绝不能加内边距——那会把卡片整体压短（用户反馈）。
     宿主太矮时由 Provider 读取 OPTION_APPWIDGET_MIN_HEIGHT 隐藏标题，
     卡片自动占满剩余空间。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/widget_top_inset">

        <LinearLayout
            android:id="@+id/widget_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_new_note_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_icon_circle"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_widget_pen"
                android:tint="@color/widget_icon_fg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0"
                android:maxLines="1"
                android:text="@string/widget_new_note_desc_text"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:text="@string/shortcut_new_note_long"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
