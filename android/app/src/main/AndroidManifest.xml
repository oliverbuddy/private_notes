<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 系统身份验证（指纹/人脸 + 锁屏凭证）。两者都是普通权限，安装时自动授予；
         Android 9 及以下的老设备读的是 USE_FINGERPRINT。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <application
        android:label="小记"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- 不再强制竖屏：平板/折叠屏需要横屏空间。
             fullUser = 跟随系统的「自动旋转」开关：手机端多数用户关着
             自动旋转，行为与之前一致；打开了才允许横屏。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 从其他 App「分享到小记」：文本与单张图片直接建一条笔记。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- 多选分享（相册一次选多张、文件管理器一次选多个）：
                 统一收成一条小记，图片内联、其余作附件卡片。
                 `*/*` 已覆盖 image/*，这里保留 image/* 让相册的
                 「分享到」候选命中得更直接。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 「用其他应用打开」Markdown 文件（微信 / 文件管理器 / 网盘）：
                 点 .md 时让「小记」出现在应用选择列表，导入成一条笔记。

                 MIME 组合要和各家 App 的实际行为对齐：
                 - 知道 markdown 的应用直接给 text/markdown；
                 - 微信等按扩展名查 MimeTypeMap，Android 不认 .md，
                   往往回落成 application/octet-stream；
                 - 部分文件管理器给 text/plain，但路径里带 .md。
                 所以这里按「MIME + URI 路径后缀」组合声明。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.md" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="text/plain"
                    android:pathPattern=".*\\.md" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="file"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.md" />
            </intent-filter>
            <!-- 少部分 App 用「分享」而不是「打开」传 .md 文件。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.md" />
            </intent-filter>
            <!-- 「用其他应用打开」常见文档：PDF 与纯文本在应用内预览（PDF 用
                 pdfrx，文本直接读），Office 等交给系统查看器，没有查看器时
                 在应用内给分享兜底（详见 AttachmentPreviewPage）。
                 各家 App 给的 MIME 不统一，这里按「标准 MIME + 后缀」两套声明：
                 标准 MIME 直接匹配；文件管理器/微信给 octet-stream 甚至 */* 时，
                 再按路径后缀兜底。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.pdf" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.txt" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.csv" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.json" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.xml" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.html" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.htm" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.log" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.doc" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.docx" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.xls" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.xlsx" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.ppt" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.pptx" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.rtf" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.odt" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.ods" />
                <data android:mimeType="application/octet-stream" android:pathPattern=".*\\.odp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.pdf" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.txt" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.csv" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.json" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.xml" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.html" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.htm" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.log" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.doc" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.docx" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.xls" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.xlsx" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.ppt" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.pptx" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.rtf" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.odt" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.ods" />
                <data android:mimeType="*/*" android:pathPattern=".*\\.odp" />
            </intent-filter>
            <!-- 少部分 App 用「分享」而不是「打开」传 PDF。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.pdf" />
            </intent-filter>
            <!-- 兜底：任何文件都能「用其他应用打开」或「分享到小记」。
                 用户要求所有文件都能被小记接住（图片内联、Markdown 作正文、
                 其余作附件卡片），这里用 */* 覆盖前面按格式精调后仍然漏掉的
                 类型（压缩包、音视频、设计稿等）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 长按图标弹出的快捷方式 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- 桌面小组件「记一条」：点击直接进空白编辑页。 -->
        <!-- android:label 决定桌面组件下方显示的名字（不设会回落到应用名「小记」）。 -->
        <receiver
            android:name=".NewNoteWidgetProvider"
            android:exported="false"
            android:label="@string/shortcut_new_note_long">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_note_widget_info" />
        </receiver>

        <!-- 快捷设置磁贴「新建小记」：下拉通知栏/锁屏快捷面板一键记录。
             属于 Android 平台能力，业务层不直接依赖。 -->
        <service
            android:name=".NewNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_pen"
            android:label="@string/shortcut_new_note_long"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 分享长图：把缓存目录里的 PNG 以 content:// 授权给其他 App。
             只开放 cache 目录（见 res/xml/share_paths.xml），不需要存储权限。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- image_picker / file_picker 在 Android 11+ 的包可见性声明，
             否则拍照、选图、选文件的 Intent 会被系统静默拦截 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
